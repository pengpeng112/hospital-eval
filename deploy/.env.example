# ============================================================================
# 医院等级评审与质控指标数据集成系统 · 部署与运行环境变量模板
# 安全红线：复制为 deploy/.env（已被 .gitignore 忽略）后在受控环境填入密钥，严禁明文入库！
# ============================================================================

# --- 目标部署宿主机（ai病历质控服务器）---
DEPLOY_SERVER_NAME=ai病历质控
DEPLOY_SSH_HOST=10.10.8.75
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=root
DEPLOY_SSH_ALIAS=hospital-eval-75
DEPLOY_BASE_DIR=/opt/hospital-eval

# --- 容器隔离端口规划（高段端口，避开 10.10.8.75 既有 AI 病历质控服务端口）---
EVAL_WEB_PORT=18080
EVAL_API_PORT=48080
EVAL_PG_PORT=15432
EVAL_REDIS_PORT=16379
EVAL_KKFILE_PORT=18012

# --- 评审系统自有专库（PostgreSQL 15）---
POSTGRES_DB=hospital_eval
POSTGRES_USER=eval_admin
POSTGRES_PASSWORD=<CHANGE_IN_UNTRACKED_LOCAL_ENV>

# --- Redis 与 JWT 鉴权密钥 ---
REDIS_PASSWORD=<CHANGE_IN_UNTRACKED_LOCAL_ENV>
JWT_SECRET=<CHANGE_IN_UNTRACKED_LOCAL_ENV>

# --- 院内 Oracle 11g 业务源库只读连接（写入严格为 0）---
ODS_RO_JDBC_URL=jdbc:oracle:thin:@10.10.8.216:1521:orcl
ODS_RO_USERNAME=<READONLY_USER_FROM_VAULT>
ODS_RO_PASSWORD=<READONLY_PASS_FROM_VAULT>

HIS_RO_JDBC_URL=jdbc:oracle:thin:@10.10.10.15:1521:his
HIS_RO_USERNAME=<READONLY_USER_FROM_VAULT>
HIS_RO_PASSWORD=<READONLY_PASS_FROM_VAULT>

# --- 院内患者 360 视图外跳 URL 模板 ---
EMR_360_URL_TEMPLATE=http://<HOSP_360_HOST>/view?patientId={patientId}&visitId={visitId}&inpNo={inpNo}
