# ============================================================================
# 医院等级评审与质控指标数据集成系统 · 环境变量模板
# 用法：复制为 deploy/.env（本机开发）或 deploy/.env.prod（生产），再填写 <...> 占位项。
# 安全红线：deploy/.env、deploy/.env.prod 已被 .gitignore 忽略，严禁提交、严禁贴到回执或聊天里。
# 生成随机密钥（PowerShell）：-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
# ============================================================================

# --- 目标部署宿主机（ai病历质控服务器，仅 TASK-19/20 使用）---
DEPLOY_SERVER_NAME=ai病历质控
DEPLOY_SSH_HOST=10.10.8.75
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=root
DEPLOY_SSH_ALIAS=hospital-eval-75
DEPLOY_BASE_DIR=/opt/hospital-eval

# --- 端口规划（高段端口，避开 10.10.8.75 既有服务；冲突时由 TASK-19 顺延）---
EVAL_WEB_PORT=18080
EVAL_API_PORT=48080
EVAL_PG_PORT=15432
EVAL_REDIS_PORT=16379
EVAL_KKFILE_PORT=18012

# --- 评审系统自有专库（PostgreSQL 15）---
POSTGRES_DB=hospital_eval
POSTGRES_USER=eval_admin
POSTGRES_PASSWORD=<填写：随机强密码>

# --- 鉴权与初始账号 ---
JWT_SECRET=<填写：40 位以上随机字符串>
EVAL_INIT_ADMIN_PASSWORD=<填写：admin 初始密码，至少 8 位含字母和数字>
EVAL_INIT_USER_PASSWORD=<填写：导入的联络员/内审员初始密码，首次登录强制修改>

# --- 文件上传与在线预览 ---
EVAL_UPLOAD_DIR=/data/uploads
# 本机开发：kkFileView 容器访问后端用 host.docker.internal；生产由 docker-compose.prod.yml 覆盖为 http://eval-server:48080
EVAL_PREVIEW_FILE_BASE_URL=http://host.docker.internal:48080

# --- 首版不使用 Redis，保留占位 ---
REDIS_PASSWORD=<首版不用，可留空>

# --- 院内 Oracle 11g 业务源库只读账号（DBA 专门发放，写入严格为 0）---
# URL 两种写法按 DBA 提供的方式二选一：SID 写法 jdbc:oracle:thin:@IP:1521:SID ；服务名写法 jdbc:oracle:thin:@//IP:1521/服务名
ODS_RO_JDBC_URL=jdbc:oracle:thin:@10.10.8.216:1521:orcl
ODS_RO_USERNAME=<DBA 发放的 ODS 只读账号>
ODS_RO_PASSWORD=<DBA 发放的 ODS 只读密码>

HIS_RO_JDBC_URL=jdbc:oracle:thin:@//10.10.10.15:1521/his
HIS_RO_USERNAME=<DBA 发放的 HIS 只读账号>
HIS_RO_PASSWORD=<DBA 发放的 HIS 只读密码>

# --- 院内患者 360 视图外跳地址（不知道可先保持原样，系统会禁用该按钮）---
EMR_360_URL_TEMPLATE=http://<HOSP_360_HOST>/view?patientId={patientId}&visitId={visitId}&inpNo={inpNo}
