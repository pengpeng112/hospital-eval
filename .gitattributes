# 默认按文本自动处理换行
* text=auto

# Linux 服务器上执行的脚本与配置必须是 LF，否则 bash 报 $'\r': command not found
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
Dockerfile* text eol=lf
.env.example text eol=lf

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# 二进制
*.xlsx binary
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jar  binary
